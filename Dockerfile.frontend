FROM node:22-bookworm-slim AS builder

WORKDIR /app
COPY . .
RUN npm ci

ARG FRONTEND
ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:7700
ARG NEXT_PUBLIC_HOWLLO_PUBLIC_WEB_URL=http://localhost:7703
ARG NEXT_PUBLIC_HOWLLO_APP_URL=http://localhost:7702
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL} \
    NEXT_PUBLIC_HOWLLO_PUBLIC_WEB_URL=${NEXT_PUBLIC_HOWLLO_PUBLIC_WEB_URL} \
    NEXT_PUBLIC_HOWLLO_APP_URL=${NEXT_PUBLIC_HOWLLO_APP_URL} \
    NEXT_PUBLIC_HOWLLO_AUTH_PROVIDER=local \
    NEXT_PUBLIC_HOWLLO_AUTH_PROVIDERS=local \
    HOWLLO_DOCKER_BUILD=true
RUN test "$FRONTEND" = howllo-app -o "$FRONTEND" = howllo-web \
    && npm -w "$FRONTEND" run build

FROM node:22-bookworm-slim
WORKDIR /app
ARG FRONTEND
ENV FRONTEND=${FRONTEND} HOSTNAME=0.0.0.0 NODE_ENV=production
COPY --from=builder --chown=node:node /app/${FRONTEND}/.next/standalone ./
COPY --from=builder --chown=node:node /app/${FRONTEND}/.next/static ./${FRONTEND}/.next/static
COPY --from=builder --chown=node:node /app/${FRONTEND}/public ./${FRONTEND}/public
USER node
CMD ["sh", "-c", "node \"${FRONTEND}/server.js\""]
