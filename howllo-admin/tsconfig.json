{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@howllo/api-client": ["../shared/api-client/src"],
      "@howllo/types": ["../shared/types/src"],
      "@howllo/config": ["../shared/config/src"],
      "@howllo/ui": ["../shared/ui/src"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
