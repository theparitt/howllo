  "query": "\n        SELECT n.id, n.body, u.display_name as author_display_name, n.created_at\n        FROM moderation_notes n\n        JOIN users u ON u.id = n.author_user_id\n        WHERE n.post_id = $1\n        ORDER BY n.created_at DESC\n        ",
