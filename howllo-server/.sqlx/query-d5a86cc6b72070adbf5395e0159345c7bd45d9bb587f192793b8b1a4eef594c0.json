  "query": "\n        INSERT INTO users (rooiam_subject, email, display_name)\n        VALUES ($1, $2, $3)\n        ON CONFLICT (rooiam_subject)\n        DO UPDATE SET email = EXCLUDED.email, display_name = EXCLUDED.display_name, updated_at = NOW()\n        RETURNING id, email, display_name\n        ",
