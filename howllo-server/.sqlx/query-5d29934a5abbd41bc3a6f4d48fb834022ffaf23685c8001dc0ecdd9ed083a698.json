{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT c.id, c.body, c.is_official_response, c.comment_type, c.created_at, u.display_name\n        FROM comments c\n        JOIN users u ON c.user_id = u.id\n        WHERE c.post_id = $1 AND c.is_hidden = false\n        ORDER BY c.created_at ASC\n        LIMIT $2 OFFSET $3\n        ",
