{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT p.id, b.slug as board_slug, p.title, p.body, p.status, p.vote_count, p.is_hidden, p.duplicate_of_post_id, p.created_at\n        FROM posts p\n        JOIN boards b ON b.id = p.board_id\n        WHERE p.tenant_id = $1\n        ORDER BY p.created_at DESC\n        ",
