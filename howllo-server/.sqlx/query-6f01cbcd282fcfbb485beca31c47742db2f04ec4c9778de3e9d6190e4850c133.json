  "query": "\n        SELECT c.id, c.body, u.display_name, c.created_at\n        FROM comments c\n        JOIN users u ON u.id = c.user_id\n        WHERE c.post_id = $1 AND c.is_hidden = false AND c.is_official_response = true\n        ORDER BY c.created_at DESC\n        LIMIT 1\n        ",
