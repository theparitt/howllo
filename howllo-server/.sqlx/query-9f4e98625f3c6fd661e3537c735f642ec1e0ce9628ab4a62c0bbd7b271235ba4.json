{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT h.id, h.old_status, h.new_status, h.reason, h.created_at, u.display_name as actor_display_name\n        FROM post_status_history h\n        JOIN users u ON h.user_id = u.id\n        WHERE h.post_id = $1\n        ORDER BY h.created_at DESC\n        ",
