  "query": "\n        SELECT tags.id, tags.slug, tags.name, tags.color\n        FROM tags\n        JOIN tenants t ON tags.tenant_id = t.id\n        WHERE t.slug = $1 AND t.is_published = TRUE\n        ORDER BY tags.name ASC\n        ",
