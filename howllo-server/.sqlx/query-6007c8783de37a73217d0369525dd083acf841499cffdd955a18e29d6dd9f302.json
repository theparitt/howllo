  "query": "\n        SELECT t.id, t.slug, t.name, t.color\n        FROM post_tags pt\n        JOIN tags t ON t.id = pt.tag_id\n        WHERE pt.post_id = $1\n        ORDER BY t.name ASC\n        ",
