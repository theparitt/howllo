  "query": "\n        SELECT\n            m.user_id,\n            u.email,\n            u.display_name,\n            m.role\n        FROM memberships m\n        JOIN users u ON u.id = m.user_id\n        WHERE m.tenant_id = $1\n        ORDER BY u.display_name ASC, u.email ASC\n        ",
