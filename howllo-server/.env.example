# All app config uses the HOWLLO_ prefix.
# HOWLLO_DATABASE_URL is what the server reads. DATABASE_URL is only needed by
# the sqlx CLI / compile-time query macros; keep the two in sync.
HOWLLO_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/howllo
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/howllo
HOWLLO_BIND_ADDRESS=127.0.0.1:7700
HOWLLO_JWT_SECRET=dev-secret
HOWLLO_ADMIN_JWT_SECRET=replace-with-a-long-random-secret
# Choose login providers here. Local is on; OIDC list is empty, so a fresh
# Howllo installation does not contact RooIAM or another identity service.
# To use only OIDC, set local=false and enable at least one OIDC entry below.
# To show multiple sign-in choices, leave local=true and add several entries.
# Local users get a one-time recovery code at registration; no SMTP is needed.
HOWLLO_AUTH_LOCAL_ENABLED=true
# Default widget for workspaces without an explicit auth setting: local/rooiam.
HOWLLO_WORKSPACE_AUTH_PROVIDER=local
# Required when HOWLLO_OIDC_PROVIDERS contains an enabled entry. Use the URLs
# that a user's browser can reach, not a Docker-only service name.
HOWLLO_PUBLIC_API_URL=http://127.0.0.1:7700
HOWLLO_CUSTOMER_WEB_ORIGIN=http://localhost:7703
# Required when tenants configure customer Google, Microsoft or OpenID Connect.
# Generate once: openssl rand -hex 32. Keep this key stable; losing it makes stored client secrets unreadable.
# HOWLLO_OIDC_CONFIG_KEY=
# Comma-separated exact issuer URLs for generic OpenID Connect. Google and tenant-specific Microsoft Entra issuers are built in.
# HOWLLO_OIDC_ALLOWED_ISSUERS=https://login.example.com/realms/product
HOWLLO_WEB_ORIGIN=http://localhost:7703
# Select OIDC providers by placing entries in this JSON array. Each entry needs
# a stable id, display_name, exact issuer, client_id and openid in scopes.
# Set enabled=false to hide and block an entry. client_secret is optional for
# public clients; set token_endpoint_auth_method=none in that case.
# Supported token_endpoint_auth_method values: client_secret_basic (default
# with a secret), client_secret_post, none (default without a secret).
HOWLLO_OIDC_PROVIDERS=[]

# Examples: uncomment ONE HOWLLO_OIDC_PROVIDERS line and replace placeholders.
# Multiple providers: put the objects together in ONE JSON array; do not define
# HOWLLO_OIDC_PROVIDERS more than once. See docs/auth/oidc.md.
# RooIAM via standard OIDC only when its issuer signs ID tokens with RS256.
# Hosted api.rooiam.com currently advertises HS256; use the widget below for it.
# The issuer is not its login-widget URL. Register the API callback for RS256.
# HOWLLO_OIDC_PROVIDERS=[{"id":"rooiam","display_name":"RooIAM","issuer":"https://YOUR_ROOIAM_ISSUER","client_id":"YOUR_ROOIAM_CLIENT_ID","client_secret":"YOUR_ROOIAM_CLIENT_SECRET","scopes":"openid profile email","enabled":true}]
# Google: register {HOWLLO_PUBLIC_API_URL}/api/auth/callback/google.
# HOWLLO_OIDC_PROVIDERS=[{"id":"google","display_name":"Google","issuer":"https://accounts.google.com","client_id":"YOUR_GOOGLE_CLIENT_ID","client_secret":"YOUR_GOOGLE_CLIENT_SECRET","token_endpoint_auth_method":"client_secret_post","scopes":"openid profile email","enabled":true}]
# Microsoft Entra ID: use a specific tenant ID in the issuer.
# HOWLLO_OIDC_PROVIDERS=[{"id":"microsoft","display_name":"Microsoft","issuer":"https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0","client_id":"YOUR_APPLICATION_ID","client_secret":"YOUR_CLIENT_SECRET","scopes":"openid profile email","enabled":true}]
# Keycloak: issuer includes the realm.
# HOWLLO_OIDC_PROVIDERS=[{"id":"keycloak","display_name":"Company SSO","issuer":"https://id.example.com/realms/YOUR_REALM","client_id":"YOUR_CLIENT_ID","client_secret":"YOUR_CLIENT_SECRET","scopes":"openid profile email","enabled":true}]
# Authentik: copy the exact issuer from its discovery document.
# HOWLLO_OIDC_PROVIDERS=[{"id":"authentik","display_name":"Authentik","issuer":"https://auth.example.com/application/o/YOUR_APP_SLUG/","client_id":"YOUR_CLIENT_ID","client_secret":"YOUR_CLIENT_SECRET","scopes":"openid profile email","enabled":true}]

# RooIAM legacy widget only (optional compatibility path, separate from OIDC).
# These THREE values identify the RooIAM login widget for the default workspace.
# Set matching NEXT_PUBLIC_ROOIAM_WIDGET_* values in howllo-app/.env.local if
# account-level sign-in needs the widget before a workspace is selected.
# HOWLLO_ROOIAM_WIDGET_BASE_URL=https://api.rooiam.com/login-widget
# HOWLLO_ROOIAM_WORKSPACE_ID=YOUR_ROOIAM_WORKSPACE_ID
# HOWLLO_ROOIAM_CLIENT_ID=YOUR_ROOIAM_CLIENT_ID
# Only old RooIAM bearer-token exchange needs a hosted userinfo endpoint.
# Leave it unset for local accounts and standard OIDC.
HOWLLO_ROOIAM_HOSTED_USERINFO_URL=
# Insecure legacy shared-secret tokens are disabled by default.
HOWLLO_ROOIAM_LEGACY_HS256_ENABLED=false
# One-time key for setting the admin password on first run. Use any value you
# like; it stops granting access once the password is set.
HOWLLO_ADMIN_BOOTSTRAP_KEY=howllo1234
HOWLLO_ALLOWED_ORIGINS=http://localhost:7701,http://127.0.0.1:7701,http://localhost:7702,http://127.0.0.1:7702,http://localhost:7703,http://127.0.0.1:7703
HOWLLO_RATE_LIMIT_ENABLED=false
HOWLLO_PUBLIC_WRITE_RATE_LIMIT=60
HOWLLO_MAX_POST_BODY_CHARS=10000
HOWLLO_MAX_COMMENT_BODY_CHARS=4000
HOWLLO_WEBHOOK_TIMEOUT_MS=5000
HOWLLO_AI_ENABLED=false
HOWLLO_AI_BASE_URL=http://127.0.0.1:11434
HOWLLO_AI_MODEL=gemma4

# Storage defaults (overridable at runtime via Platform Settings → Storage).
HOWLLO_STORAGE_ROOT=./data/uploads
HOWLLO_STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:7700/uploads
HOWLLO_MINIO_ENDPOINT=
HOWLLO_MINIO_BUCKET=
HOWLLO_MINIO_USER=
HOWLLO_MINIO_PASSWORD=
