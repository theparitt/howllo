# Copy to .env.production and replace the domains with your actual public HTTPS origins.
# Public URLs are embedded in browser bundles during build.
NEXT_PUBLIC_API_BASE_URL=https://api.howllo.dev
NEXT_PUBLIC_HOWLLO_APP_URL=https://app.howllo.dev
NEXT_PUBLIC_HOWLLO_PUBLIC_WEB_URL=https://feedback.howllo.dev
NEXT_PUBLIC_ROOIAM_WIDGET_BASE_URL=https://api.rooiam.com/login-widget
NEXT_PUBLIC_ROOIAM_WIDGET_WORKSPACE_ID=YOUR_WORKSPACE_ID
NEXT_PUBLIC_ROOIAM_WIDGET_CLIENT_ID=YOUR_CLIENT_ID
