NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:7700
NEXT_PUBLIC_HOWLLO_APP_URL=http://localhost:7702
NEXT_PUBLIC_HOWLLO_AUTH_PROVIDER=local
