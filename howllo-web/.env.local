# Browser-side API calls — match the host you load the site from (localhost)
# so client fetches stay same-origin with the page. The backend also allows
# both localhost and 127.0.0.1 via HOWLLO_ALLOWED_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:7700
NEXT_PUBLIC_HOWLLO_AUTH_PROVIDER=rooiam
NEXT_PUBLIC_HOWLLO_AUTH_PROVIDERS=rooiam

NEXT_PUBLIC_ROOIAM_WIDGET_BASE_URL=https://api.rooiam.com/login-widget
NEXT_PUBLIC_ROOIAM_WIDGET_WORKSPACE_ID=59d94bdf-2549-4fb8-b57c-900a6a67f3dd
NEXT_PUBLIC_ROOIAM_WIDGET_CLIENT_ID=it8UF4GAFxIL1CWess88Wce0voYWe8pOCn1DrMLPwS0
