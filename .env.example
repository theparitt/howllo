# ── Howllo environment example ──────────────────────────────────────────────
# Reference values for local development. Copy server values to howllo-server/.env
# App and public Web each have their own .env.example and .env.local.

# ── Database (howllo-server) ────────────────────────────────────────────────
# The server reads HOWLLO_DATABASE_URL. DATABASE_URL is only for the sqlx CLI
# and compile-time query macros; keep the two in sync.
HOWLLO_DATABASE_URL=postgres://postgres:postgres@localhost:5433/howllo
DATABASE_URL=postgres://postgres:postgres@localhost:5433/howllo

# ── Ports (canonical map — see shared/config/src/ports.ts) ───────────────────
# 7700 howllo-server   (Rust/Actix API)
# 7701 howllo-admin    (Vite + React)
# 7702 howllo-app      (Next.js tenant management)
# 7703 howllo-web      (Next.js public boards)
# 7700/ws board websocket
# 5114 howllo-landing
# 5115 howllo-widget   (reserved, later)
# 5116 howllo-docs

# ── Frontend base URLs ──────────────────────────────────────────────────────
HOWLLO_API_BASE_URL=http://127.0.0.1:7700
HOWLLO_BOARD_ADMIN_BASE_URL=http://127.0.0.1:7701
HOWLLO_BOARD_WS_URL=ws://127.0.0.1:7700/ws
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=howllo-6soj

# ── Storage (howllo-server; overridable in Platform Settings → Storage) ──────
HOWLLO_STORAGE_ROOT=./data/uploads
HOWLLO_STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:7700/uploads
HOWLLO_MINIO_ENDPOINT=http://127.0.0.1:9000
HOWLLO_MINIO_BUCKET=howllo
HOWLLO_MINIO_USER=minioadmin
HOWLLO_MINIO_PASSWORD=minioadmin

# ── Auth provider selection (copy server values to howllo-server/.env) ───────
# Local only is the default. Set false when you want OIDC only.
HOWLLO_AUTH_LOCAL_ENABLED=true
# Use rooiam here if all new workspaces should use the RooIAM widget.
HOWLLO_WORKSPACE_AUTH_PROVIDER=local
# Required when an OIDC provider is enabled; use browser-reachable URLs.
HOWLLO_PUBLIC_API_URL=http://127.0.0.1:7700
HOWLLO_WEB_ORIGIN=http://localhost:7703
HOWLLO_OIDC_PROVIDERS=[]
# Choose OIDC providers by adding enabled entries to ONE JSON array.
# RooIAM OIDC needs issuer, client_id and usually client_secret, and its issuer
# must sign RS256 ID tokens. Hosted api.rooiam.com currently uses the widget below.
# HOWLLO_OIDC_PROVIDERS=[{"id":"rooiam","display_name":"RooIAM","issuer":"https://YOUR_ROOIAM_ISSUER","client_id":"YOUR_CLIENT_ID","client_secret":"YOUR_CLIENT_SECRET","scopes":"openid profile email","enabled":true}]
# Google, Microsoft, Keycloak and Authentik examples are commented in
# howllo-server/.env.example. Multiple entries can appear in the same array.
# Legacy RooIAM widget uses three separate server values (unnecessary for OIDC).
# HOWLLO_ROOIAM_WIDGET_BASE_URL=https://api.rooiam.com/login-widget
# HOWLLO_ROOIAM_WORKSPACE_ID=YOUR_WORKSPACE_ID
# HOWLLO_ROOIAM_CLIENT_ID=YOUR_CLIENT_ID
# Old RooIAM bearer-token exchange only:
HOWLLO_ROOIAM_HOSTED_USERINFO_URL=

# ── Frontend values ──────────────────────────────────────────────────────────
# Copy howllo-app/.env.example to howllo-app/.env.local for RooIAM management.
# Copy howllo-web/.env.example to howllo-web/.env.local for local public accounts.
