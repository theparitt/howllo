# ── Howllo environment example ──────────────────────────────────────────────
# Copy to .env and adjust. The server reads its own apps/howllo-server/.env.

# ── Database (howllo-server) ────────────────────────────────────────────────
# The server reads HOWLLO_DATABASE_URL. DATABASE_URL is only for the sqlx CLI
# and compile-time query macros; keep the two in sync.
HOWLLO_DATABASE_URL=postgres://postgres:postgres@localhost:5433/howllo
DATABASE_URL=postgres://postgres:postgres@localhost:5433/howllo

# ── Ports (canonical map — see packages/config/src/ports.ts) ────────────────
# 5110 howllo-server   (Rust/Actix API)
# 5111 howllo-admin    (Vite + React)
# 5112 howllo-web      (Next.js public boards)
# 5113 board websocket
# 5114 howllo-landing
# 5115 howllo-widget   (reserved, later)
# 5116 howllo-docs

# ── Frontend base URLs ──────────────────────────────────────────────────────
HOWLLO_API_BASE_URL=http://127.0.0.1:5110
HOWLLO_BOARD_ADMIN_BASE_URL=http://127.0.0.1:5111
HOWLLO_BOARD_WS_URL=ws://127.0.0.1:5113
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=rooiam

# ── Storage (howllo-server; overridable in Platform Settings → Storage) ──────
HOWLLO_STORAGE_ROOT=./data/uploads
HOWLLO_STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:5110/uploads
HOWLLO_MINIO_ENDPOINT=http://127.0.0.1:9000
HOWLLO_MINIO_BUCKET=howllo
HOWLLO_MINIO_USER=minioadmin
HOWLLO_MINIO_PASSWORD=minioadmin

# ── Auth (Rooiam identity provider) ─────────────────────────────────────────
ROOIAM_ISSUER=
ROOIAM_JWKS_URL=
